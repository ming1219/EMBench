# Fixture tool server. Replays recorded tool results and keeps a server-side call log.
# python:3.12-slim pinned by digest so every build uses the identical base image
FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1
ARG PIP_INDEX_URL=https://pypi.org/simple
RUN pip install --no-cache-dir -i ${PIP_INDEX_URL} "mcp==1.27.2" "rdkit==2026.3.3"
WORKDIR /srv
COPY . /srv
EXPOSE 8000
CMD ["python", "/srv/tool_server.py"]
